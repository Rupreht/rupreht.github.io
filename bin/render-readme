#!/usr/bin/env bash
#
# Собирает README.md сайта из канона содержания и шаблона оформления.
# Канон живёт в репозитории my (DevOpsEngineer.senior.md), оформление - в _templates.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMPLATE="$REPO_DIR/_templates/readme.md.tmpl"
MARKER='<!-- RESUME -->'
POINTER='**Машиночитаемая версия**: [README.md](https://raw.githubusercontent.com/rupreht/rupreht.github.io/refs/heads/master/README.md) (text/markdown, без HTML).'
PROVENANCE='<!-- AUTOGENERATED'
ANCHOR='Ожидания: '

usage() {
  cat <<'EOF'
Использование: bin/render-readme <canonical.md> [--output <file>] [--check]

  <canonical.md>   канон содержания, например ../my/DevOpsEngineer.senior.md
  --output <file>  файл результата, по умолчанию README.md в корне репозитория
  --check          ничего не писать, сверить результат с файлом и упасть при расхождении
EOF
}

die() {
  printf 'render-readme: %s\n' "$*" >&2
  exit 1
}

canonical=""
output="$REPO_DIR/README.md"
check_only=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --output)
      [ "$#" -ge 2 ] || die "--output требует значение"
      output="$2"
      shift 2
      ;;
    --check)
      check_only=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "неизвестный аргумент: $1"
      ;;
    *)
      [ -z "$canonical" ] || die "канон указан дважды"
      canonical="$1"
      shift
      ;;
  esac
done

[ -n "$canonical" ] || { usage >&2; exit 2; }
[ -f "$canonical" ] || die "нет файла канона: $canonical"
[ -s "$canonical" ] || die "канон пуст: $canonical"
[ -f "$TEMPLATE" ] || die "нет шаблона: $TEMPLATE"

markers=$(grep -cF -- "$MARKER" "$TEMPLATE" || true)
[ "$markers" -eq 1 ] || die "в шаблоне должен быть ровно один маркер $MARKER, найдено: $markers"

anchors=$(grep -c "^${ANCHOR}" "$canonical" || true)
[ "$anchors" -eq 1 ] || die "в каноне должна быть ровно одна строка с началом '$ANCHOR', найдено: $anchors"

if grep -nF -- '<!--' "$canonical"; then
  die "в каноне остались HTML-комментарии, уберите их"
fi

if grep -nE -- '(TODO|FIXME|TBD|XXX)' "$canonical"; then
  die "в каноне остались плейсхолдеры, уберите их"
fi

head=$(awk -v m="$MARKER" 'index($0, m) == 1 { exit } { print }' "$TEMPLATE")
tail=$(awk -v m="$MARKER" 'done { print } index($0, m) == 1 { done = 1 }' "$TEMPLATE")
body=$(awk -v anchor="$ANCHOR" -v ptr="$POINTER" '
  { print }
  !done && index($0, anchor) == 1 { print ""; print ptr; done = 1 }
  END { if (!done) exit 3 }
' "$canonical") || die "не удалось вставить указатель после строки '$ANCHOR'"

rendered=$(mktemp)
trap 'rm -f "$rendered"' EXIT

{
  if [ -n "$head" ]; then
    printf '%s\n\n' "$head"
  fi
  printf '%s\n' "$body"
  printf '\n%s\n' "$tail"
} > "$rendered"

grep -qF -- "$PROVENANCE" "$rendered" || die "в результате нет строки провенанса"
grep -qF -- "$POINTER" "$rendered" || die "в результате нет указателя на markdown"
if grep -qF -- "$MARKER" "$rendered"; then
  die "маркер $MARKER попал в результат"
fi

if [ "$check_only" -eq 1 ]; then
  [ -f "$output" ] || die "нет файла для сверки: $output"
  if ! diff -u "$output" "$rendered"; then
    die "$output расходится с каноном, запустите bin/render-readme <canonical.md>"
  fi
  printf '%s\n' "$output актуален"
  exit 0
fi

cp "$rendered" "$output"
printf '%s\n' "$output собран из $canonical"
